RewriteEngine On

RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ router.php [QSA,L]

<FilesMatch "\.(env|sql|md)$">
    Require all denied
</FilesMatch>

Options -Indexes
